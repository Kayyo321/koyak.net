# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# OPENAI_API_KEY: optional locally; without it chat answers "can't find my voice" and story turns use authored logic.
OPENAI_API_KEY=sk-placeholder
# STORY_PACK_KEY: 32 random bytes, base64. `npm run story:keygen` writes a fresh one here for you.
STORY_PACK_KEY=base64-32-byte-key-placeholder
